# Required: get a FREE Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the primary Gemini model (defaults to gemini-3.5-flash-lite with auto-fallback)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: custom path for the SQLite database file (defaults to ./jarvis.db)
# JARVIS_DB_PATH=jarvis.db
