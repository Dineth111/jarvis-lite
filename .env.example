# Required: get a FREE Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: custom path for the SQLite database file (defaults to ./jarvis.db)
# JARVIS_DB_PATH=jarvis.db
