# Required: get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: override the Claude model (defaults to claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: custom path for the SQLite database file (defaults to ./jarvis.db)
# JARVIS_DB_PATH=jarvis.db
